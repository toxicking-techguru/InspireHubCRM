
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow unauthenticated read and list on agents to support the pre-authorization login check
    // This allows the login page to query the collection by email before the user exists in Auth
    match /agents/{agentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Explicitly allow list operations on the agents collection
    match /agents {
      allow read, list: if true;
    }

    // Default: Must be authenticated for all other data
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
