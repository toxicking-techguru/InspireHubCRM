
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow unauthenticated read on agents to support the pre-authorization login check
    match /agents/{agentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: Must be authenticated for all other data
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
